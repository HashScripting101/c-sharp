<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- net8.0-windows is required: COM automation of Outlook is Windows-only.
         If you are on .NET 6 or 7, change this to net6.0-windows / net7.0-windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OutlookFileSearch</RootNamespace>
    <AssemblyName>OutlookFileSearch</AssemblyName>

    <!-- Required for late-bound COM via 'dynamic'. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads .docx (Word) files -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />

    <!-- Reads .xlsx (XSSF) and legacy .xls (HSSF) files -->
    <PackageReference Include="NPOI" Version="2.7.1" />

    <!-- Needed by NPOI for legacy .xls code pages (Windows-1252 etc.) -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />

    <!-- Enables the C# 'dynamic' keyword used for late-bound Outlook COM.
         Included implicitly on .NET 5+, listed here for clarity. -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>

</Project>
