// =============================================================================
// ComHelper.cs
// -----------------------------------------------------------------------------
// Replacement for Marshal.GetActiveObject(), which existed in .NET Framework
// but was REMOVED in .NET Core / .NET 5+. Without this, "attach to the already
// running Outlook" is not available and you would always spawn a second
// Outlook process.
//
// DEPENDENCIES: none - plain P/Invoke into ole32.dll and oleaut32.dll,
//               both part of Windows.
// =============================================================================

using System;
using System.Runtime.InteropServices;

namespace OutlookFileSearch
{
    internal static class ComHelper
    {
        // Looks up a ProgID (e.g. "Outlook.Application") in the registry
        // and returns its CLSID.
        [DllImport("ole32.dll", CharSet = CharSet.Unicode, PreserveSig = false)]
        private static extern void CLSIDFromProgIDEx(
            [MarshalAs(UnmanagedType.LPWStr)] string lpszProgID,
            out Guid lpclsid);

        // Fetches an object already registered in the Running Object Table.
        [DllImport("oleaut32.dll", PreserveSig = false)]
        private static extern void GetActiveObject(
            ref Guid rclsid,
            IntPtr pvReserved,
            [MarshalAs(UnmanagedType.IUnknown)] out object ppunk);

        /// <summary>
        /// Returns the running COM instance for the given ProgID,
        /// or null if that application is not currently running.
        /// </summary>
        public static object? GetRunningInstance(string progId)
        {
            try
            {
                CLSIDFromProgIDEx(progId, out var clsid);
                GetActiveObject(ref clsid, IntPtr.Zero, out var instance);
                return instance;
            }
            catch (COMException)
            {
                // MK_E_UNAVAILABLE - nothing registered in the ROT: app not running.
                return null;
            }
            catch (Exception)
            {
                return null;
            }
        }
    }
}
